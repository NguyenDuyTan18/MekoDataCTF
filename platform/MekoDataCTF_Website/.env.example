PORT=3000
NODE_ENV=development

# Chuỗi ngẫu nhiên dài, ví dụ tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Tài khoản Ban tổ chức (tạo bằng: npm run seed)
ADMIN_EMAIL=admin@mekodatactf.local
ADMIN_PASSWORD=ChangeMe123!

# Đồng bộ token đội website → ForcAD (services/forcadSync.js): tự chạy khi website khởi động,
# định kỳ, và ngay sau khi tạo/sửa đội, cấp token mới, đổi "Tên đội trên ForcAD".
FORCAD_URL=http://127.0.0.1:18080
# Để trống mật khẩu thì website đọc mục admin trong ../ForcAD-demo/config.yml (hoặc file ở FORCAD_CONFIG).
FORCAD_ADMIN_USER=
FORCAD_ADMIN_PASSWORD=
# FORCAD_CONFIG=../ForcAD-demo/config.yml
# Chu kỳ đồng bộ (giây); 0 = chỉ đồng bộ khi khởi động và khi có thay đổi trên website.
FORCAD_SYNC_INTERVAL=60
