<section class="section">
  <div class="container auth-wrap">
    <div class="card auth-card auth-card--split">
      <h1><%= t('team.chooseTitle') %></h1>
      <p class="muted"><%= t('team.chooseIntro', { name: user.full_name || user.email }) %></p>

      <% if (!registrationOpen) { %>
        <div class="alert alert-warning"><%= t('team.locked') %></div>
      <% } else if (!profileOk) { %>
        <%# Tài khoản tạo trước khi đăng ký có họ tên/MSSV: bổ sung trước khi tạo/vào đội %>
        <div class="alert alert-warning"><%= t('team.profileMissingHint') %></div>
        <%- include('../partials/errors') %>
        <form action="/team/profile" method="post" class="form" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>
            <span><%= t('team.fullName') %></span>
            <input type="text" name="fullName" required minlength="2" maxlength="80" autocomplete="name">
          </label>
          <label>
            <span><%= t('team.studentId') %></span>
            <input type="text" name="studentId" required pattern="[A-Za-z0-9]{4,15}" maxlength="15" class="mono" autocomplete="off">
          </label>
          <button type="submit" class="btn btn-primary"><%= t('team.save') %></button>
        </form>
      <% } else { %>
        <div class="auth-split">
          <div class="auth-pane">
            <p class="auth-pane-kicker mono"><%= t('team.createKicker') %></p>
            <h2 class="auth-pane-title"><%= t('team.createTitle') %></h2>
            <p class="muted auth-pane-note"><%= t('team.createHint') %></p>
            <%- include('../partials/errors') %>
            <form action="/team/create" method="post" class="form" novalidate>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label>
                <span><%= t('team.name') %> *</span>
                <input type="text" name="name" value="<%= createData.name %>" required minlength="2" maxlength="50">
              </label>
              <label>
                <span><%= t('team.school') %></span>
                <input type="text" name="school" value="<%= createData.school %>" maxlength="120">
              </label>
              <label>
                <span><%= t('team.phone') %></span>
                <input type="tel" name="phone" value="<%= createData.phone %>" maxlength="20">
              </label>
              <button type="submit" class="btn btn-primary btn-block"><%= t('team.createSubmit') %></button>
            </form>
          </div>

          <div class="auth-pane auth-pane--token">
            <p class="auth-pane-kicker mono"><%= t('team.joinKicker') %></p>
            <h2 class="auth-pane-title"><%= t('team.joinTitle') %></h2>
            <p class="muted auth-pane-note"><%= t('team.joinHint') %></p>
            <% if (joinErrors.length) { %>
              <div class="alert alert-error" role="alert"><ul><% joinErrors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
            <% } %>
            <form action="/team/join" method="post" class="form" novalidate>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label>
                <span><%= t('team.tokenTitle') %></span>
                <input type="text" name="token" value="<%= joinCode %>" class="token-input" required autocomplete="off" spellcheck="false"
                       maxlength="16" pattern="[0-9a-fA-F]{16}" placeholder="<%= t('team.tokenPlaceholder') %>">
              </label>
              <button type="submit" class="btn btn-outline btn-block"><%= t('team.joinSubmit') %></button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>
