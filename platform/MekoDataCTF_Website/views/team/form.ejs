<section class="section">
  <div class="container narrow">
    <div class="card">
      <h1><%= title %></h1>
      <%- include('../partials/errors') %>

      <form action="/team" method="post" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-2">
          <label>
            <span><%= t('team.name') %> *</span>
            <input type="text" name="name" value="<%= data.name %>" required minlength="2" maxlength="50">
          </label>
          <label>
            <span><%= t('team.email') %></span>
            <input type="email" value="<%= user.email %>" disabled>
          </label>
          <label>
            <span><%= t('team.school') %></span>
            <input type="text" name="school" value="<%= data.school %>" maxlength="120">
          </label>
          <label>
            <span><%= t('team.phone') %></span>
            <input type="tel" name="phone" value="<%= data.phone %>" maxlength="20">
          </label>
        </div>
        <p class="muted"><%= t('team.membersManagedHint') %></p>
        <div class="form-actions">
          <a href="/team" class="btn btn-ghost"><%= t('team.cancel') %></a>
          <button type="submit" class="btn btn-primary"><%= t('team.save') %></button>
        </div>
      </form>
    </div>
  </div>
</section>
