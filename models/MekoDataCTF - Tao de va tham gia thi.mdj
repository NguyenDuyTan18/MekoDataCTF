                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
                  },
                  "parentStyle": false,
                  "text": "BƯỚC 09 · SSH QUẢN TRỊ\nLấy cấu hình theo sandbox và khóa theo pool.\nBTC và collector dùng Management Access.\nGiữ khóa quản trị trên máy vận hành.",
                  "left": 66,
                  "top": 908,
                  "width": 360,
                  "height": 102,
                  "wordWrap": false,
                  "font": "Arial;15;0",
                  "fontColor": "#172B43",
