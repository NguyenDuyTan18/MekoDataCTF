                  "fillColor": "#F3F7FB"
                },
                {
                  "_type": "UMLNoteLinkView",
                  "_id": "iTi3kM/s/7R5ZYFTFlLOGw==",
                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
