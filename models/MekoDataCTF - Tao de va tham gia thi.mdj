                  "_id": "hvqc0wPLk8bYOWdzC04meg==",
                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
                  },
                  "parentStyle": false,
                  "text": "BƯỚC 01 · ĐIỀU KIỆN BAN ĐẦU\nWebsite, ForcAD và CyberRangeCZ đã hoạt động.\nBTC có quyền quản trị và kết nối tới cloud.",
                  "left": 500,
                  "top": 215,
                  "width": 408,
                  "height": 89,
                  "wordWrap": false,
