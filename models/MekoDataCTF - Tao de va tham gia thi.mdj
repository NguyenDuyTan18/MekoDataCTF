                  "lineColor": "#6A8199",
                  "points": "426:952;489:952"
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "808cFtK4n1oY2bLSfCoX5Q==",
                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
                  },
                  "parentStyle": false,
                  "text": "BƯỚC 11 · THIẾT LẬP CỜ VÀ CHECKER\nKhai flag_template trong lab_profile.py.\nĐối chiếu định dạng và độ dài với app/checker.\nLuồng vòng tùy biến gán flag_lifetime = 2.\nRà nhịp tick, cửa sổ chấm và timeout checker.\nXác nhận wrapper chạy được trong worker.",
                  "left": 966,
                  "top": 843,
                  "width": 374,
                  "height": 139,
                  "wordWrap": false,
                  "font": "Arial;15;0",
                  "fontColor": "#172B43",
                  "lineColor": "#AB7B22",
                  "fillColor": "#FFF4D7"
                },
                {
                  "_type": "UMLNoteLinkView",
                  "_id": "RUqzpZGjlEZX/oDmr76xGQ==",
