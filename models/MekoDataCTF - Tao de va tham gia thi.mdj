                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
                  },
                  "parentStyle": false,
                  "text": "BƯỚC 08 · NẾU ALLOCATE BÁO LỖI\nXem log giai đoạn lỗi trước khi thử lại.\nPortal cho thử lại bước mạng và provisioning.\nLỗi cấp cloud cần xử lý rồi cấp phát lại.",
                  "left": 966,
                  "top": 714,
                  "width": 374,
                  "height": 99,
                  "wordWrap": false,
                  "font": "Arial;15;0",
