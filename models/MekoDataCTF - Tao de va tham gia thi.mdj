                },
                {
                  "_type": "UMLNoteView",
                  "_id": "tkIIihRlG4iyCLQd1rJzcA==",
                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
                  },
                  "parentStyle": false,
                  "text": "BƯỚC 05 · GÓI ĐỀ ĐÃ BÀN GIAO\nĐầu vào gồm app, dữ liệu và checker.\nLogic check / put / get thuộc kịch bản đề.\nPlaybook cài các thành phần lên đúng VM.",
                  "left": 966,
                  "top": 510,
                  "width": 374,
                  "height": 100,
                  "wordWrap": false,
                  "font": "Arial;15;0",
                  "fontColor": "#172B43",
