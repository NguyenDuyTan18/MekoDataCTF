                },
                {
                  "_type": "UMLNoteView",
                  "_id": "yyug7NnZQKhPKbLZ+yLoFg==",
                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
                  },
                  "parentStyle": false,
                  "text": "BƯỚC 03 · ÁNH XẠ ĐỘI, VM VÀ IP\nRà danh sách vì lệnh xuất lấy mọi đội.\nDùng cùng ánh xạ trong lab.json, topology,\nprovisioning và profile ForcAD.",
                  "left": 66,
                  "top": 525,
                  "width": 360,
                  "height": 104,
                  "wordWrap": false,
                  "font": "Arial;15;0",
                  "fontColor": "#172B43",
