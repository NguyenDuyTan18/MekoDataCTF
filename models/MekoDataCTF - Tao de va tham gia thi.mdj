                  "fillColor": "#F3F7FB"
                },
                {
                  "_type": "UMLNoteLinkView",
                  "_id": "Qx41k7jyIrbdH2Xs7eTXAw==",
                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
