                  "_parent": {
                    "$ref": "uBZtSArbQ5m4w41FLOUphw=="
                  },
                  "parentStyle": false,
                  "text": "BƯỚC 07 · KHI DÙNG LẠI SANDBOX\nRà VM, mạng, quyền và trạng thái dữ liệu.\nNếu phù hợp, triển khai gói đề trên VM cũ\nrồi nối lại ForcAD và nghiệm thu.",
                  "left": 66,
                  "top": 708,
                  "width": 360,
                  "height": 104,
                  "wordWrap": false,
                  "font": "Arial;15;0",
                  "fontColor": "#172B43",
