            },
            {
              "_type": "UMLAction",
              "_id": "TT6k3/zlQhKY9/zIP23pfA==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Tiếp nhận gói đề và chốt tham số",
              "documentation": "Chốt mã đề, đội thi, quyền và cách vào VM từ Training.\nXác định số VM và số sandbox cần cấp.\n\nChốt tên kỹ thuật và ánh xạ đội–VM dự kiến. Khi sân đấu dùng chung một sandbox, xác định cách Training hướng dẫn mỗi đội tới VM được cấp và cách tách quyền theo đội."
            },
            {
              "_type": "UMLMergeNode",
              "_id": "w1xDk+4IRg2+nRNgqb6DQQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              }
            },
            {
              "_type": "UMLMergeNode",
              "_id": "flN0ftiAR7qihEtSs/quRQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              }
            },
            {
              "_type": "UMLAction",
              "_id": "2fz7AlWbQMWFbdM1iYbSXg==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Chuẩn bị Topology Definition",
              "documentation": "Khai máy ảo, image, mạng và cấu hình kết nối.\nĐầu ra: topology.yml theo mẫu của CyberRangeCZ."
            },
            {
              "_type": "UMLAction",
              "_id": "K/HQnwmgQsqxz4LntJ2p2Q==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Chuẩn bị cấu hình provisioning",
              "documentation": "Dùng khung Ansible để cài gói đề lên đúng nhóm VM.\nLưu topology và provisioning cùng phiên bản trong Git.\n\nChỉ khai báo cách triển khai các thành phần đã bàn giao. Ghim revision đã kiểm thử để có thể tái tạo môi trường."
            },
            {
              "_type": "UMLAction",
              "_id": "PjDSzIYzTGyxzsy1S5ftSA==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Đăng ký Sandbox Definition",
              "documentation": "Nhập URI Git và revision trên Portal CyberRangeCZ.\nDùng định nghĩa đã có nếu trỏ đúng phiên bản.\n\nhttps://docs.platform.cyberrange.cz/basic-concepts/typical-training-workflow/training-workflow-cloud/"
            },
            {
              "_type": "UMLAction",
              "_id": "yWnFC7efTGCuZ0HJkUkmow==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Tạo hoặc chọn Sandbox Pool",
              "documentation": "Chọn đúng Sandbox Definition và sức chứa cần thiết.\nKiểm tra số sandbox còn trống khi dùng pool có sẵn.\n\nhttps://docs.platform.cyberrange.cz/basic-concepts/typical-training-workflow/training-workflow-cloud/"
            },
            {
              "_type": "UMLAction",
              "_id": "gKh7FXvjSlO72L/iwAwyng==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Cấp phát sandbox",
              "documentation": "Allocate số sandbox cần bổ sung trong pool.\nTheo dõi tiến độ tạo VM, mạng và provisioning.\n\nhttps://docs.platform.cyberrange.cz/basic-concepts/typical-training-workflow/training-workflow-cloud/"
            },
            {
              "_type": "UMLAction",
              "_id": "mRIIq/lIReWfD7jCGohm6w==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Xác nhận sandbox hoạt động",
              "documentation": "Kiểm tra trạng thái cấp phát, log và kết nối quản trị.\nXác nhận dịch vụ đã lên và quyền truy cập đúng."
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "C/7jDlYQQSWDo7/1btV21Q==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              }
            },
            {
              "_type": "UMLAction",
              "_id": "glF76fQ6RYyj43ASMnPIFA==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Xử lý lỗi cấp phát hoặc provisioning",
              "documentation": "Xem log giai đoạn lỗi. Cập nhật cấu hình nếu cần.\nThử lại bước lỗi hoặc cấp phát lại khi cần.\n\nNếu topology/provisioning thay đổi, cập nhật revision Sandbox Definition rồi dùng pool phù hợp. Nếu lỗi tạm thời, giữ cấu hình và thử lại thao tác hỗ trợ tại giai đoạn lỗi."
            },
            {
              "_type": "UMLForkNode",
              "_id": "0ZZAY13FQpG+KIwYwUgUNA==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              }
            },
            {
              "_type": "UMLAction",
              "_id": "Hg2TCVsxSkeHuREpozbZoQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Tạo hoặc nhập Training Definition",
              "documentation": "Nạp nội dung đề đã bàn giao và hướng dẫn vào VM.\nDùng Access Level để hướng dẫn truy cập sandbox.\n\nTraining Definition có thể chuẩn bị độc lập với Sandbox Definition. Dùng trạng thái và quyền phù hợp khi chọn định nghĩa. https://docs.platform.cyberrange.cz/user-guide-basic/training-agenda/training-definition/linear-training-definition/#iv-access-level"
            },
            {
              "_type": "UMLAction",
              "_id": "lgWkrdhNSZuP43g55GhBNQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Tạo Training Instance",
              "documentation": "Chọn Training Definition và chế độ Cloud.\nĐặt thời gian truy cập, chọn Organizer rồi lưu.\n\nhttps://docs.platform.cyberrange.cz/user-guide-basic/training-agenda/training-instance/"
            },
            {
              "_type": "UMLAction",
              "_id": "GkqNCE6jR7iqTafzs/51DQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Gán pool cho Training Instance",
              "documentation": "Trong Assign Pool, chọn pool chưa khóa.\nKiểm tra sức chứa theo phương án Training Run.\n\nhttps://docs.platform.cyberrange.cz/user-guide-basic/training-agenda/training-instance/"
            },
            {
              "_type": "UMLAction",
              "_id": "qvhW/vFlQbKwlcPSvs5rkQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Chuẩn bị quyền và token chạy thử",
              "documentation": "Lấy access token của Instance thử.\nCấp token cho tài khoản thử có quyền Trainee.\n\nhttps://docs.platform.cyberrange.cz/user-guide-basic/training-agenda/training-instance/"
            },
            {
              "_type": "UMLAction",
              "_id": "gfK85zfjROSvXxJfPff6iw==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Chạy thử Training Run",
              "documentation": "Vào Portal, nhập token và mở đề trong Training Run.\nKiểm tra sandbox của run và đường vào VM được cấp.\n\nMột Training Run nhận một sandbox từ pool. Dùng Instance/pool thử phù hợp để tránh sử dụng sandbox đã bị thay đổi khi tổ chức chính thức. https://docs.platform.cyberrange.cz/basic-concepts/typical-training-workflow/training-workflow-cloud/"
            },
            {
              "_type": "UMLAction",
              "_id": "3/zFigphR4SyC2GIWmeykw==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Chốt ánh xạ đội, VM và quyền truy cập",
              "documentation": "Đối chiếu IP thực tế với danh sách đội và lab.json.\nLấy Management Access cho máy vận hành.\n\nManagement Access dành cho BTC và collector. Đối chiếu sandbox và VM đội truy cập qua hướng dẫn trong Training với địa chỉ mà hệ thống chấm sử dụng."
            },
            {
              "_type": "UMLAction",
              "_id": "bWD3Ej71TNmJsLOQV1tfBQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Khai báo profile và adapter chấm",
              "documentation": "Dùng mẫu ForcAD cho đội, task và lịch của đề.\nĐăng ký adapter tương thích checker đã bàn giao.\n\nDùng khung cấu hình của repo và đối chiếu tên task, ID đội, thông số chấm và định dạng cờ."
            },
            {
              "_type": "UMLAction",
              "_id": "n2uVXnBERSK9Gm95n+n61g==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Chuẩn bị đề và đồng bộ đội",
              "documentation": "Nạp profile ForcAD và đối chiếu đội trên website.\nĐồng bộ token nộp cờ cho đúng đội."
            },
            {
              "_type": "UMLAction",
              "_id": "oAn/VRVdS0+X0KuQq/5Uhw==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Kết nối collector với sandbox",
              "documentation": "Chọn mã lab và kiểm tra đường ForcAD → collector\n→ agent trong sandbox."
            },
            {
              "_type": "UMLAction",
              "_id": "OV675NVaTV6B/f63hdRxxg==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Kiểm tra luồng chấm thử",
              "documentation": "Xác nhận ForcAD kiểm tra đúng dịch vụ của đội.\nThử nộp cờ mẫu và cập nhật bảng điểm."
            },
            {
              "_type": "UMLJoinNode",
              "_id": "Qrmdh6oHRjmwOdvpZovMUg==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              }
            },
            {
              "_type": "UMLAction",
              "_id": "s6n0yt7PRQi2Pv+1cHHPkA==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Thi thử cùng một lượt A/D",
              "documentation": "Vào đề từ Training và truy cập đúng VM của đội.\nXác nhận Website và ForcAD chấm trên cùng sân đấu.\n\nThử bằng tài khoản Trainee của các đội. Đối chiếu VM mà mỗi đội được cấp với VM ForcAD chấm, kiểm tra tách quyền giữa các đội và phối hợp thời gian truy cập Training với lịch vòng ForcAD."
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "Zl6ZCdb6SVWBUo8qG549fQ==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              }
            },
            {
              "_type": "UMLAction",
              "_id": "hnuuJXq3TSy1ODpl/ZqF0Q==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Sửa cấu hình và chạy thử lại",
              "documentation": "Sửa cấu hình theo kết quả thử. Kiểm tra lại\nmôi trường, quyền vào đề và luồng chấm điểm.\n\nGiữ cấu hình và tài nguyên đã đạt. Chỉ điều chỉnh hoặc cấp phát lại phần bị ảnh hưởng trước khi thử lại."
            },
            {
              "_type": "UMLAction",
              "_id": "pNm4CahbR4WYzenkzL5y2w==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              },
              "name": "Chuẩn bị và bàn giao lượt chính thức",
              "documentation": "Chốt môi trường sạch, lịch Training và lịch ForcAD.\nCấp quyền vào Training và VM theo đúng lịch.\n\nChuẩn bị Training Instance/pool chính thức và token theo lịch, đồng thời làm sạch trạng thái dịch vụ và dữ liệu chấm. Đối chiếu lại ánh xạ VM, quyền của đội và thời điểm mở vòng. Bàn giao phiên bản gói đề cùng kết quả nghiệm thu."
            },
            {
              "_type": "UMLActivityFinalNode",
              "_id": "Bt50Pt9MSZiJVmX8oIbEPg==",
              "_parent": {
                "$ref": "EmHUKR4FR0emGf4y8GbNsw=="
              }
            }
