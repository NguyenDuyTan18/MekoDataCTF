                },
                {
                  "_type": "UMLControlNodeView",
                  "_id": "V7POrfOJTDm6neIj5H38kA==",
                  "_parent": {
                    "$ref": "FRzs38O2SyS6TVk3hbDwTg=="
                  },
                  "parentStyle": false,
                  "model": {
                    "$ref": "Bt50Pt9MSZiJVmX8oIbEPg=="
                  },
                  "left": 753,
                  "top": 1792,
                  "width": 25,
                  "height": 25,
                  "lineColor": "#17324D",
                  "fillColor": "#FFFFFF"
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "jrmpocGkQsGLyiqjXz+Wsg==",
                  "_parent": {
                    "$ref": "FRzs38O2SyS6TVk3hbDwTg=="
                  },
                  "parentStyle": false,
                  "text": "GÓI ĐỀ BÀN GIAO · ĐẦU VÀO THEO TỪNG ĐỀ\nNội dung đề, ứng dụng, dữ liệu mẫu và checker.\nKịch bản check / put / get nằm trong gói đề.",
                  "left": 35,
                  "top": 178,
                  "width": 442,
                  "height": 91,
                  "wordWrap": false,
                  "font": "Arial;16;0",
                  "fontColor": "#17324D",
                  "lineColor": "#9BACBC",
                  "fillColor": "#F5F8FB"
                },
                {
                  "_type": "UMLNoteLinkView",
                  "_id": "0GpsHZ/IQM6rqzBZXBU4xQ==",
                  "_parent": {
                    "$ref": "FRzs38O2SyS6TVk3hbDwTg=="
                  },
                  "parentStyle": false,
                  "tail": {
                    "$ref": "jrmpocGkQsGLyiqjXz+Wsg=="
                  },
                  "head": {
                    "$ref": "7g4cMXRtQvKIdvJ9jPJlVQ=="
                  },
                  "lineStyle": 0,
                  "lineColor": "#8A9CAC",
                  "points": "477:222;520:222"
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "kl88UpTRSReRoa32AD7awg==",
                  "_parent": {
                    "$ref": "FRzs38O2SyS6TVk3hbDwTg=="
                  },
                  "parentStyle": false,
                  "text": "ĐIỀU KIỆN BAN ĐẦU\nPortal và cloud đã hoạt động.\nCó tài khoản, vai trò và hạn mức cần thiết.\nA/D cần Website và ForcAD đã sẵn sàng.",
                  "left": 35,
                  "top": 324,
                  "width": 442,
                  "height": 108,
                  "wordWrap": false,
                  "font": "Arial;16;0",
                  "fontColor": "#17324D",
                  "lineColor": "#9BACBC",
                  "fillColor": "#F5F8FB"
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "eKwLYDcLQNGFU+eDQTtqYw==",
                  "_parent": {
                    "$ref": "FRzs38O2SyS6TVk3hbDwTg=="
                  },
                  "parentStyle": false,
                  "text": "SANDBOX POOL\nSố sandbox trong pool là số bản sao môi trường.\nSố VM trong mỗi sandbox do topology quy định.",
                  "left": 35,
                  "top": 570,
                  "width": 442,
                  "height": 89,
                  "wordWrap": false,
                  "font": "Arial;16;0",
                  "fontColor": "#17324D",
                  "lineColor": "#9BACBC",
                  "fillColor": "#F5F8FB"
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "sHLokCDKQhOdXVPs9KW73w==",
                  "_parent": {
                    "$ref": "FRzs38O2SyS6TVk3hbDwTg=="
                  },
                  "parentStyle": false,
                  "text": "CẤU HÌNH THEO PHIÊN BẢN\nChốt revision Git trước khi cấp phát.\nChỉ dùng lại định nghĩa và pool tương thích.\nKiểm tra quyền, sức chứa và trạng thái dữ liệu.",
                  "left": 1070,
                  "top": 472,
                  "width": 425,
                  "height": 108,
                  "wordWrap": false,
                  "font": "Arial;16;0",
                  "fontColor": "#17324D",
                  "lineColor": "#9BACBC",
                  "fillColor": "#F5F8FB"
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "dL5Ml70rQSe1jNrdQUbwyA==",
                  "_parent": {
                    "$ref": "FRzs38O2SyS6TVk3hbDwTg=="
                  },
                  "parentStyle": false,
                  "text": "ÁNH XẠ QUYỀN VÀO SÂN ĐẤU\nTraining Run nhận một sandbox từ pool.\nNếu các đội chung sân đấu, xác nhận mỗi đội\nđi từ Training tới đúng VM trong sân đó.\nToken Training dùng để mở đề trên Portal.\nToken ForcAD gắn với đội để nộp cờ.",
                  "left": 555,
                  "top": 1161,
                  "width": 421,
                  "height": 139,
                  "wordWrap": false,
                  "font": "Arial;16;0",
                  "fontColor": "#17324D",
                  "lineColor": "#9BACBC",
                  "fillColor": "#F5F8FB"
                },
